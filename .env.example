# Copy this file to .env and change the values. .env is never committed.

# Flask
SECRET_KEY=change-me

# Docker Compose PostgreSQL
POSTGRES_USER=community_centre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=community_centre
POSTGRES_PORT=5432

# Connections used by the backend and by the tests.
# Keep user, password, port and database name in step with the values above.
# The test database is created by Docker Compose as <POSTGRES_DB>_test.
DATABASE_URL=postgresql://community_centre:change-me@localhost:5432/community_centre
TEST_DATABASE_URL=postgresql://community_centre:change-me@localhost:5432/community_centre_test
