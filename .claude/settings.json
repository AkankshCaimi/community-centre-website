{
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)",
      "Bash(pytest:*)", "Bash(make test:*)", "Bash(make lint:*)"
    ],
    "deny": [
      "Read(.env)", "Read(.env.*)",
      "Bash(curl:*)", "Bash(wget:*)", "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-existing-tests.sh"
          }
        ]
      }
    ]
  }
}